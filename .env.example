# Vercel + Supabase production environment variables
NODE_ENV=production
DAPUR_RINI_OPERATION_MODE=PRODUCTION
DAPUR_RINI_COOKIE_SECURE=true

# Supabase Database: gunakan Transaction pooler, port 6543.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres
DAPUR_RINI_DB_SSL=require
DAPUR_RINI_DB_POOL_SIZE=1
DAPUR_RINI_DB_IDLE_TIMEOUT_MS=5000
DAPUR_RINI_DB_CONNECT_TIMEOUT_MS=10000

# Supabase Storage. Gunakan secret key server-side, bukan publishable key.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_GANTI_DENGAN_SECRET_KEY
SUPABASE_PUBLIC_MEDIA_BUCKET=dapur-rini-public-media
SUPABASE_PRIVATE_PROOF_BUCKET=dapur-rini-private-proofs

# Kredensial aplikasi. Buat nilai baru dengan: npm run generate:secrets
DAPUR_RINI_ADMIN_PASSWORD=ganti-dengan-password-minimal-12-karakter
DAPUR_RINI_PASSWORD_SALT=ganti-dengan-random-secret-minimal-16-karakter
DAPUR_RINI_DEVICE_PIN=654321
DAPUR_RINI_SESSION_MINUTES=30
DAPUR_RINI_TRUSTED_DEVICE_DAYS=30
